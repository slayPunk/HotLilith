+        return {.success = false, .error = "Ungroup windows in the requested scope before opening the canvas"};
+
+    if (arg == "off" || (arg == "toggle" && WAS_ACTIVE) || SCOPE_CHANGE) {
+        syspunkCanvasStop();
+        disableScrollOverviewHooks();
+    }
+    if (arg == "off" || (arg == "toggle" && WAS_ACTIVE))
+        return {};
+    if (!MONITOR)
