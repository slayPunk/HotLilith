+    const bool SCOPE_CHANGE = arg == "scope" || arg == "workspace" || arg == "global";
+    if (arg == "scope") workspaceOnly = !workspaceOnly;
+    else if (arg == "workspace") workspaceOnly = true;
+    else if (arg == "global") workspaceOnly = false;
+    else if (arg != "toggle" && arg != "on" && arg != "off")
+        return {.success = false, .error = "invalid canvas mode action"};
+
